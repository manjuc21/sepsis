FROM node:22-slim

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ .

EXPOSE 5173

# Vite's dev server, not a production nginx build — this is a demo project
# (CLAUDE.md §2.5), not a real deployment, and the dev server gives fast
# reload during the viva/demo prep.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
