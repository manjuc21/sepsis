# Copy to .env and adjust as needed. Defaults match docker-compose services.

# Postgres connection (docker-compose service name "db" when run via compose;
# use localhost when running the API outside Docker against a mapped port).
DATABASE_URL=postgresql://sepsis:sepsis@db:5432/sepsis
POSTGRES_USER=sepsis
POSTGRES_PASSWORD=sepsis
POSTGRES_DB=sepsis

# FastAPI
API_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
